# Server Configuration
PORT=5000
NODE_ENV=development


# PostgreSQL Connection
# For local Docker setup: postgresql://postgres:postgres@localhost:5432/athena
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/athena

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Client Configuration
CLIENT_URL=http://localhost:5173

# Branding (Optional)
APP_NAME=Athena
COMPANY_NAME=Athena Productivity Labs

# Email Service (Brevo Transactional Email)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# External Quotes API
API_NINJAS=
