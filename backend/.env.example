# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# For local Docker setup: mongodb://localhost:27017/athena
MONGODB_URI=mongodb://localhost:27017/athena

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Client Configuration
CLIENT_URL=http://localhost:5173

# Branding (Optional)
APP_NAME=Athena
COMPANY_NAME=Athena Productivity Labs

# Email Service (SMTP - Optional in local development)
EMAIL_USER=
EMAIL_PASS=

# External Quotes API (Optional)
API_NINJAS=
